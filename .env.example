# Vercel: required SERVER-ONLY variables. Never use a VITE_ prefix for secrets.
FLAPPY_BIRD_TURSO_DATABASE_URL=libsql://your-database-your-organization.turso.io
FLAPPY_BIRD_TURSO_AUTH_TOKEN=
# Legacy alternative: remove the prefixed pair above and configure BOTH of these.
# TURSO_DATABASE_URL=libsql://your-database-your-organization.turso.io
# TURSO_AUTH_TOKEN=
# Explicit day boundary for today's leaderboard, independent of the host's TZ.
LEADERBOARD_TIMEZONE=Asia/Shanghai
# Local-only settings (not used by Vercel Functions).
# PORT=3000
# DATABASE_PATH=./data/flappy.sqlite
